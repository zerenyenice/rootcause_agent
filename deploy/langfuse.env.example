# Self-hosted Langfuse server secrets (optional `observability` profile of
# deploy/docker-compose.yml; T009, ADR-0006).
#
#   cp deploy/langfuse.env.example deploy/langfuse.env   # gitignored
#   docker compose -f deploy/docker-compose.yml --profile observability up -d
#
# Only needed for the observability profile: a plain `docker compose up` (the
# base stack) never reads this file, and Compose does not require it to exist.
# Without it the Langfuse services refuse to start.
#
# Every value below is a PLACEHOLDER: replace each one before the first start
# and never commit the resulting deploy/langfuse.env. Use hex secrets
# (`openssl rand -hex 32`): the Postgres password is embedded in a URL, so
# characters like @ : / # would break it.
#
# This file is handed unchanged to the Langfuse containers (langfuse-web,
# -worker, -postgres, -clickhouse, -redis, -minio), so the names below are the
# ones those images read. Lines using ${...} are derived from a value set
# earlier in this file; leave them as they are. Note that Compose resolves
# ${...} from deploy/.env and the shell FIRST, so do not define the
# LANGFUSE_POSTGRES_PASSWORD / LANGFUSE_MINIO_ROOT_PASSWORD names there.
#
# Client-side settings (ROOTCAUSE_LANGFUSE_*) and the published ports
# (LANGFUSE_PORT, LANGFUSE_MINIO_PORT) stay in deploy/.env.

# --- Langfuse web/worker ------------------------------------------------------
# Signs NextAuth session cookies (web only): `openssl rand -hex 32`.
NEXTAUTH_SECRET=change-me-langfuse-nextauth-secret
# Salt for hashing API keys: `openssl rand -hex 32`.
SALT=change-me-langfuse-salt
# Encrypts sensitive data at rest. Exactly 64 hex characters (256 bits):
# `openssl rand -hex 32`. Changing it later makes stored secrets unreadable.
ENCRYPTION_KEY=change-me-langfuse-encryption-key-64-hex-characters

# --- langfuse-postgres (Langfuse metadata; not the RootCause database) -------
# `openssl rand -hex 32`. Set once: the database keeps the first password it
# was initialised with (reset the volume to change it, see deploy/README.md).
LANGFUSE_POSTGRES_PASSWORD=change-me-langfuse-postgres-password
POSTGRES_PASSWORD=${LANGFUSE_POSTGRES_PASSWORD}
DATABASE_URL=postgresql://langfuse:${LANGFUSE_POSTGRES_PASSWORD}@langfuse-postgres:5432/langfuse

# --- langfuse-clickhouse (traces/observations) -------------------------------
# Read by both ClickHouse (user `clickhouse`) and Langfuse: `openssl rand -hex 32`.
CLICKHOUSE_PASSWORD=change-me-langfuse-clickhouse-password

# --- langfuse-redis (queues/cache) -------------------------------------------
# Redis --requirepass and Langfuse's REDIS_AUTH: `openssl rand -hex 32`.
REDIS_AUTH=change-me-langfuse-redis-password

# --- langfuse-minio (S3 event/media storage, root user `minio`) --------------
# `openssl rand -hex 32` (MinIO needs at least 8 characters).
LANGFUSE_MINIO_ROOT_PASSWORD=change-me-langfuse-minio-password
MINIO_ROOT_PASSWORD=${LANGFUSE_MINIO_ROOT_PASSWORD}
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=${LANGFUSE_MINIO_ROOT_PASSWORD}
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=${LANGFUSE_MINIO_ROOT_PASSWORD}

# --- Optional headless setup on first start ----------------------------------
# Creates the org, project and admin user and gives the project the API keys
# below. Runs only when LANGFUSE_INIT_ORG_ID is set; leave these commented out
# to sign up in the UI and create the keys there instead.
# The two project keys must equal ROOTCAUSE_LANGFUSE_PUBLIC_KEY and
# ROOTCAUSE_LANGFUSE_SECRET_KEY in deploy/.env (the API's client keys). They
# live here, not in docker-compose.yml, so `docker compose config` never
# prints the secret key.
#LANGFUSE_INIT_ORG_ID=rootcause
#LANGFUSE_INIT_PROJECT_ID=rootcause
#LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-change-me
#LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-change-me
#LANGFUSE_INIT_USER_EMAIL=admin@example.com
#LANGFUSE_INIT_USER_PASSWORD=change-me-langfuse-admin-password
