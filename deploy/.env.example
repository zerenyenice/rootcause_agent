# RootCause local stack: environment for deploy/docker-compose.yml.
#
#   cp deploy/.env.example deploy/.env    # deploy/.env is gitignored (.env, .env.*)
#
# Every value here is a PLACEHOLDER. Replace all of them before `docker
# compose up`; never commit the resulting deploy/.env. Generate secrets with
# `openssl rand -hex 32`. CI validates the compose file against this example
# (`compose-config` job), so keep each variable the compose file requires
# (`${VAR:?}`) present here with a placeholder value.

# --- Postgres 16 + pgvector --------------------------------------------------
POSTGRES_USER=rootcause
POSTGRES_DB=rootcause
POSTGRES_PASSWORD=change-me-postgres-password
# Login passwords of the migrator and runtime roles that postgres/init.sql
# creates on the first start (docs/adr/0007). Keep them in sync with the
# ROOTCAUSE_MIGRATION_DATABASE_URL / ROOTCAUSE_DATABASE_URL values below.
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator-password
POSTGRES_APP_PASSWORD=change-me-app-password
# Host port, bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# --- OpenViking server (0.3.x) ----------------------------------------------
# Host port, bound to 127.0.0.1 only.
OPENVIKING_PORT=1933
# Root API key the server requires when bound to 0.0.0.0 inside the container.
# Root key = admin access; the API will use a per-account user key created via
# the Admin API (see deploy/README.md), not this key.
OPENVIKING_ROOT_API_KEY=change-me-openviking-root-key
# Embedding provider used by OpenViking (OpenAI-compatible by default; use
# provider=ollama + a local api_base for air-gapped setups). The dimension
# MUST match the model (text-embedding-3-small = 1536, -3-large = 3072).
OPENVIKING_EMBEDDING_PROVIDER=openai
OPENVIKING_EMBEDDING_API_BASE=https://api.openai.com/v1
OPENVIKING_EMBEDDING_API_KEY=change-me-embedding-provider-api-key
OPENVIKING_EMBEDDING_MODEL=text-embedding-3-small
OPENVIKING_EMBEDDING_DIMENSION=1536
# VLM OpenViking uses to write directory summaries (L0/L1). Provider, base URL
# and key default to the embedding ones when left unset; the model is required.
OPENVIKING_VLM_MODEL=gpt-5.4
#OPENVIKING_VLM_PROVIDER=openai
#OPENVIKING_VLM_API_BASE=https://api.openai.com/v1
#OPENVIKING_VLM_API_KEY=change-me-vlm-provider-api-key

# --- Application services: web, api, agent, migrate (docs/plans/MVP.md) ----
# Host ports, bound to 127.0.0.1 only. There is NO authentication in the MVP:
# never publish these on another interface.
WEB_PORT=3000
API_PORT=8000
AGENT_PORT=8100
# URLs the BROWSER uses to reach api and agent. Inlined into the web bundle at
# build time (Next.js NEXT_PUBLIC_*): change them together with API_PORT /
# AGENT_PORT and rebuild with `docker compose up -d --build web`. Public
# values, never secrets.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AGENT_URL=http://localhost:8100
# Host directory mounted read-only at /data in api and agent (relative to
# deploy/). Generate the demo warehouse into it from the repo root with
#   uv run python -m rootcause.evals.manufacturing generate --out data/warehouse
# and register it as a DuckDB connection with the path
# /data/warehouse/warehouse.duckdb.
DATA_DIR=../data
# Container-side overrides (compose replaces the host-oriented values below
# inside api/agent/migrate; ROOTCAUSE_DATABASE_URL and
# ROOTCAUSE_MIGRATION_DATABASE_URL are rebuilt from the POSTGRES_* passwords
# with host `postgres`, ROOTCAUSE_OPENVIKING_URL becomes http://openviking:1933).
# Langfuse as reached FROM the containers; default http://langfuse-web:3000
# (the observability profile). For Langfuse Cloud use its https URL.
#CONTAINER_LANGFUSE_HOST=http://langfuse-web:3000
# Legacy single-warehouse setting inside the containers (leave unset when the
# warehouse is registered as a connection).
#CONTAINER_WAREHOUSE_PATH=/data/warehouse/warehouse.duckdb

# --- RootCause settings (rootcause.settings, ROOTCAUSE_* prefix) ------------
# The api, agent and migrate containers read this whole file (env_file); the
# stack's own secrets above (POSTGRES_*, OPENVIKING_*_KEY) are blanked for
# them in docker-compose.yml. The same file also serves a host-run API (copy
# it to the repo root, where rootcause.settings reads `.env` in dev/test):
# that is why the URLs below use localhost.
ROOTCAUSE_ENVIRONMENT=dev
ROOTCAUSE_LOG_LEVEL=INFO
#
# Database roles (docs/adr/0007). The API connects as the least-privilege
# runtime role, never as the Postgres superuser; password = POSTGRES_APP_PASSWORD.
ROOTCAUSE_DATABASE_URL=postgresql://rootcause_app:change-me-app-password@localhost:5432/rootcause
# `rootcause-db upgrade/downgrade/current/revision` connect as the migrator
# (member of the NOLOGIN owner role); password = POSTGRES_MIGRATOR_PASSWORD.
ROOTCAUSE_MIGRATION_DATABASE_URL=postgresql://rootcause_migrator:change-me-migrator-password@localhost:5432/rootcause
# `rootcause-db bootstrap` (superuser, once per database; compose's init.sql
# already does the same for the local stack). Set it only in the shell that
# runs bootstrap, not in a long-lived .env; password = POSTGRES_PASSWORD.
#ROOTCAUSE_ADMIN_DATABASE_URL=postgresql://rootcause:change-me-postgres-password@localhost:5432/rootcause
# Role names; these are the defaults and must match postgres/init.sql.
ROOTCAUSE_DB_OWNER_ROLE=rootcause_owner
ROOTCAUSE_DB_MIGRATOR_ROLE=rootcause_migrator
ROOTCAUSE_DB_APP_ROLE=rootcause_app
ROOTCAUSE_OPENVIKING_URL=http://localhost:1933
# Fernet key that encrypts connection credentials at rest (connections API).
# Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it makes stored connection passwords unreadable.
ROOTCAUSE_SECRET_KEY=change-me-fernet-key
# Browser origins allowed to call the agent service (JSON list).
ROOTCAUSE_AGENT_ALLOWED_ORIGINS=["http://localhost:3000"]
# Legacy single-warehouse path for a host-run API/agent (inside compose use
# CONTAINER_WAREHOUSE_PATH above).
#ROOTCAUSE_WAREHOUSE_PATH=data/warehouse/warehouse.duckdb
ROOTCAUSE_OTEL_EXPORTER=none
#ROOTCAUSE_OTEL_ENDPOINT=http://localhost:4318

# --- Service clients (T008: rootcause.clients) -------------------------------
# MIGRATION: the bare ANTHROPIC_API_KEY that LangChain used to read implicitly
# is no longer consulted. Set ROOTCAUSE_ANTHROPIC_API_KEY instead; every client
# key, endpoint and limit now lives under the ROOTCAUSE_ prefix.
#
# Chat models. ROOTCAUSE_LLM_PROVIDER is the default for every role; a role's
# *_PROVIDER overrides it (leave unset to inherit). Model values are Anthropic
# model ids (an `anthropic:` prefix is accepted) or Azure OpenAI deployment
# names, depending on the role's resolved provider. If ANY role resolves to
# azure_openai, ROOTCAUSE_AZURE_OPENAI_ENDPOINT and _API_KEY are required.
ROOTCAUSE_LLM_PROVIDER=anthropic
#ROOTCAUSE_ORCHESTRATOR_PROVIDER=anthropic
#ROOTCAUSE_FAST_PROVIDER=azure_openai
#ROOTCAUSE_REASONING_PROVIDER=anthropic
ROOTCAUSE_ORCHESTRATOR_MODEL=claude-opus-5
ROOTCAUSE_FAST_MODEL=claude-sonnet-5
ROOTCAUSE_REASONING_MODEL=claude-opus-5
ROOTCAUSE_ANTHROPIC_API_KEY=change-me-anthropic-api-key
#ROOTCAUSE_AZURE_OPENAI_ENDPOINT=https://change-me.openai.azure.com
#ROOTCAUSE_AZURE_OPENAI_API_KEY=change-me-azure-openai-api-key
#ROOTCAUSE_AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Per-role reasoning effort for Azure OpenAI reasoning models: none, minimal, low,
# medium or high. Unset keeps the provider default; Anthropic roles ignore it.
#ROOTCAUSE_ORCHESTRATOR_REASONING_EFFORT=medium
#ROOTCAUSE_FAST_REASONING_EFFORT=low
#ROOTCAUSE_REASONING_REASONING_EFFORT=high
ROOTCAUSE_LLM_TIMEOUT_S=60
# 0 disables retries.
ROOTCAUSE_LLM_MAX_RETRIES=2
ROOTCAUSE_LLM_MAX_TOKENS=8192
# Rows an EXPLAIN may estimate before a query needs human approval.
ROOTCAUSE_SCAN_ROW_THRESHOLD=5000000
#
# Embeddings (validated lazily on first use). azure_openai reuses the Azure
# endpoint/key above with EMBEDDING_MODEL as the deployment name;
# openai_compatible needs EMBEDDING_API_BASE (key optional for keyless servers).
# EMBEDDING_DIMENSIONS must match the model (text-embedding-3-small = 1536).
ROOTCAUSE_EMBEDDING_PROVIDER=openai_compatible
ROOTCAUSE_EMBEDDING_MODEL=text-embedding-3-small
ROOTCAUSE_EMBEDDING_DIMENSIONS=1536
ROOTCAUSE_EMBEDDING_API_BASE=https://api.openai.com/v1
ROOTCAUSE_EMBEDDING_API_KEY=change-me-embedding-provider-api-key
ROOTCAUSE_EMBEDDING_BATCH_SIZE=64
#
# OpenViking per-account user key (NOT OPENVIKING_ROOT_API_KEY), sent as
# X-API-Key; see deploy/README.md for creating it via the Admin API.
ROOTCAUSE_OPENVIKING_API_KEY=change-me-openviking-user-key

# --- Langfuse: agent tracing and prompt management (T009, ADR-0006) ---------
# RootCause side (rootcause.clients.langfuse). Off by default; with
# ROOTCAUSE_LANGFUSE_ENABLED=false nothing is sent anywhere. Turning tracing on
# (or ROOTCAUSE_PROMPT_SOURCE=langfuse) makes HOST and both KEYS required.
# Traces are masked before export: tool outputs are denied by default (only
# write_todos, explain_sql and the run_sql summary stay visible), SQL rows
# never enter traces, every credential setting is redacted, and the exporter
# scrubs span attributes, error messages and events. See ADR-0006 for what
# masking cannot catch.
# Python SDK 5.x needs Langfuse server v4.59.0 or later (see the
# observability profile below for a self-hosted one).
# Never set LANGFUSE_DEBUG in production: SDK debug logs print unmasked spans.
ROOTCAUSE_LANGFUSE_ENABLED=false
# Must be https, except for loopback (localhost, 127.0.0.1, ::1) or a
# single-label compose service name such as http://langfuse-web:3000.
# Host-run value (LANGFUSE_PORT below); the containers use
# CONTAINER_LANGFUSE_HOST instead.
ROOTCAUSE_LANGFUSE_HOST=http://localhost:3001
# Project API keys (Langfuse UI: Project settings > API keys, or seeded by
# LANGFUSE_INIT_* in deploy/langfuse.env).
ROOTCAUSE_LANGFUSE_PUBLIC_KEY=pk-lf-change-me
ROOTCAUSE_LANGFUSE_SECRET_KEY=sk-lf-change-me
# Optional release/version tag recorded on every trace.
#ROOTCAUSE_LANGFUSE_RELEASE=2026.10.1
# Fraction of runs traced, 0.0 to 1.0.
ROOTCAUSE_LANGFUSE_SAMPLE_RATE=1.0
# Regex pass replacing e-mails, phone numbers, IBANs and Turkish national ids
# in trace text with markers. Keep it on unless the customer signs off.
ROOTCAUSE_LANGFUSE_MASK_PII=true
#
# Prompts: `files` uses the prompts shipped in the code; `langfuse` fetches the
# version carrying ROOTCAUSE_PROMPT_LABEL (cached for _CACHE_TTL_S seconds) and
# falls back to the shipped file whenever Langfuse fails. Prompts resolve when
# the orchestrator is built (process start), not per run. Keep `files` in prod
# unless the team decides otherwise. Upload the shipped prompts with
# `uv run python scripts/push_prompts.py --apply`, using an operator's key,
# never the API's runtime key.
ROOTCAUSE_PROMPT_SOURCE=files
ROOTCAUSE_PROMPT_LABEL=production
ROOTCAUSE_PROMPT_CACHE_TTL_S=300

# --- Self-hosted Langfuse server (optional `observability` profile) ----------
#   cp deploy/langfuse.env.example deploy/langfuse.env   # its secrets live there
#   docker compose -f deploy/docker-compose.yml --profile observability up -d
# Only the published ports are set here (bound to 127.0.0.1 only); the base
# stack needs nothing else for Langfuse. 3001, because the RootCause web UI
# owns 3000.
LANGFUSE_PORT=3001
# MinIO S3 endpoint the browser/SDK uploads media to (presigned URLs).
LANGFUSE_MINIO_PORT=9090
